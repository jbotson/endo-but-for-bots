{
  "name": "@endo/tavern",
  "version": "0.1.0",
  "private": true,
  "description": "Endo agent framework that runs SillyTavern character cards as autonomous agents",
  "keywords": [],
  "author": "Endo contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endojs/endo.git",
    "directory": "packages/tavern"
  },
  "bugs": {
    "url": "https://github.com/endojs/endo/issues"
  },
  "type": "module",
  "exports": {
    ".": "./agent.js",
    "./src/tool-makers.js": "./src/tool-makers.js",
    "./src/disk-backend.js": "./src/disk-backend.js",
    "./src/import.js": "./src/import.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "exit 0",
    "setup": "endo run --UNCONFINED setup.js --powers @agent",
    "tavern-factory-setup": "endo run --UNCONFINED tavern-factory-setup.js --powers @agent -E PROVIDER_NAME=${PROVIDER_NAME:-default} -E FACTORY_NAME=${FACTORY_NAME:-tavern-factory}",
    "create-agent": "node scripts/create-agent.js",
    "rebind-provider": "node scripts/rebind-provider.js",
    "destroy-agent": "node scripts/destroy-agent.js",
    "grant-scheduling": "node scripts/grant-scheduling.js",
    "grant-factory": "node scripts/grant-factory.js",
    "import-card": "node scripts/import-card.js",
    "import-chat": "node scripts/import-chat.js",
    "import-all": "node scripts/import-all.js",
    "test": "ava",
    "lint": "yarn lint:eslint",
    "lint-fix": "yarn lint:eslint --fix",
    "lint:eslint": "eslint '**/*.js'"
  },
  "ava": {
    "files": [
      "test/**/*.test.*"
    ],
    "timeout": "2m"
  },
  "dependencies": {
    "@endo/conversation-tree": "workspace:^",
    "@endo/daemon": "workspace:^",
    "@endo/errors": "workspace:^",
    "@endo/eventual-send": "workspace:^",
    "@endo/exo": "workspace:^",
    "@endo/fae": "workspace:^",
    "@endo/far": "workspace:^",
    "@endo/harden": "workspace:^",
    "@endo/init": "workspace:^",
    "@endo/lal": "workspace:^",
    "@endo/marshal": "workspace:^",
    "@endo/patterns": "workspace:^",
    "@endo/promise-kit": "workspace:^",
    "@endo/where": "workspace:^"
  },
  "devDependencies": {
    "@endo/cli": "workspace:^",
    "ava": "catalog:dev",
    "eslint": "catalog:dev"
  },
  "eslintConfig": {
    "extends": [
      "plugin:@endo/internal"
    ]
  }
}
